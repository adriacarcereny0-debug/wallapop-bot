# ─────────────────────────────────────────────────────────────────────────────
# Wallapop Assistant — variables de entorno
#
# Copia este fichero a `.env.local` (local) o pégalas en Vercel (producción).
# NUNCA escribas claves reales aquí ni subas `.env.local` al repositorio.
#
# Las marcadas OBLIGATORIA son imprescindibles: sin ellas la aplicación no
# arranca. Es intencionado, para que un despliegue mal configurado falle al
# desplegar y no a mitad de la petición de un usuario.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────────────────────
# URL pública. En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Base de datos y autenticación — OBLIGATORIAS ─────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de Storage para las fotos. Lo crea la migración SQL.
SUPABASE_STORAGE_BUCKET=product-images

# ── Inteligencia artificial — OBLIGATORIA ────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modelo principal: redacta el texto que se publica.
#   claude-opus-5    → máxima calidad      (~5 $/1M entrada, 25 $/1M salida)
#   claude-sonnet-5  → equilibrio          (~2 $/1M, 10 $/1M)
#   claude-haiku-4-5 → el más económico    (~1 $/1M, 5 $/1M)
ANTHROPIC_MODEL=claude-opus-5
# Modelo económico para trabajo de usar y tirar (respuestas, análisis de chat).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Tope de gasto por usuario y día, en céntimos de dólar. 0 = sin tope.
AI_DAILY_BUDGET_CENTS=500

# ── Cifrado de tokens — OBLIGATORIA ──────────────────────────────────────────
# Cifra los tokens OAuth de Wallapop antes de guardarlos (AES-256-GCM).
# Genera una con:  openssl rand -base64 32
# ⚠️ Si la cambias, todas las cuentas conectadas tendrán que reconectarse.
TOKEN_ENCRYPTION_KEY=

# ── Mejora de imágenes — OPCIONAL ────────────────────────────────────────────
# "none" = se suben fotos pero no se mejoran. "gemini" tiene nivel gratuito.
IMAGE_PROVIDER=none
# aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Alternativa de pago
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# ── Wallapop Connect — OPCIONAL hasta tener el alta de integrador ────────────
# Las tres van juntas o se dejan las tres vacías.
# Requiere cuenta de vendedor profesional y solicitar el alta como aplicación
# integradora. Lee docs/WALLAPOP_INTEGRATION.md antes de rellenarlas.
# Sin ellas la aplicación funciona entera salvo publicar/conectar cuentas.
WALLAPOP_CLIENT_ID=
WALLAPOP_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con la registrada en Wallapop.
WALLAPOP_REDIRECT_URI=http://localhost:3000/api/wallapop/oauth/callback
