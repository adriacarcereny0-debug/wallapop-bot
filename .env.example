# ─────────────────────────────────────────────────────────────────────────────
# Wallapop Assistant — plantilla de variables de entorno
#
# Copia este fichero a `.env.local` y rellena los valores.
# NUNCA escribas claves reales aquí ni subas `.env.local` al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicación ───────────────────────────────────────────────────────────────
# URL pública de la app. En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo de datos: "demo" (sin servicios externos) o "supabase".
# Con "demo" la aplicación es totalmente funcional sin base de datos.
DATA_MODE=demo

# ── Supabase (sólo si DATA_MODE=supabase) ────────────────────────────────────
# Panel Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Proveedor de IA ──────────────────────────────────────────────────────────
# "demo" (respuestas deterministas locales, coste 0) | "anthropic"
AI_PROVIDER=demo
# Clave del proveedor. SOLO servidor — jamás expuesta al frontend.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Tope de gasto orientativo por usuario y día, en céntimos de euro (0 = sin tope).
AI_DAILY_BUDGET_CENTS=500

# ── Proveedor de imágenes ────────────────────────────────────────────────────
# "demo" | "openai" | "gemini". Ver docs/AI_PROVIDERS.md
IMAGE_PROVIDER=demo
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Integración Wallapop Connect ─────────────────────────────────────────────
# DESACTIVADA POR DEFECTO. Léase docs/WALLAPOP_INTEGRATION.md antes de activarla.
# Requiere cuenta de vendedor profesional y alta como aplicación integradora.
WALLAPOP_INTEGRATION_ENABLED=false
WALLAPOP_CLIENT_ID=
WALLAPOP_CLIENT_SECRET=
WALLAPOP_REDIRECT_URI=http://localhost:3000/api/wallapop/oauth/callback

# Clave de cifrado para los tokens OAuth guardados en base de datos (AES-256-GCM).
# Genera una con: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
